---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";

const resourceCategories = [
	{
		title: "School & District Resources",
		resources: [
			{
				title: "BUSD Volunteer Information",
				description:
					"Information and requirements for volunteering at schools in the Berryessa Union School District.",
				href: "https://sites.google.com/busd.net/busdvolunteer/home",
			},
			{
				title: "Ruskin PTA",
				description:
					"Visit the Ruskin PTA website for information about parent involvement, school activities, and community events.",
				href: "https://sites.google.com/ruskinpta.org/ruskinpta/home",
			},
			{
				title: "Sierramont PTSA",
				description:
					"Visit the Sierramont PTSA website for information about parent involvement, school activities, and community events.",
				href: "https://sites.google.com/view/smsptsa/home",
			},
		],
	},
	{
		title: "BMDIB Resources",
		resources: [
			{
				title: "Volunteer Reimbursement Form",
				description:
					"Use this form to request reimbursement for preapproved BMDIB volunteer expenses. Only preapproved expenses are eligible for reimbursement.",
				href: "https://docs.google.com/document/d/1fxix9lCU33gePAxdKC0iZbul2V9Oy6WEf0v0C5R4eOI/edit?usp=sharing",
			},
		],
	},
	{
		title: "Mandarin Education & Community",
		resources: [
			{
				title: "Association of Northern California Chinese Schools (ANCCS)",
				description:
					"Learn more about ANCCS, which organizes educational activities and competitions for Chinese language learners in Northern California.",
				href: "https://www.anccs.org/",
			},
		],
	},
];
---

<BaseLayout
	title="Resources | Mandarin Boosters"
	description="Helpful resources for BMDIB families, volunteers, students, and the Mandarin Dual Immersion community."
>
	<PageHeader
		eyebrow="Helpful Information"
		title="Resources"
		description="Explore useful links for families, volunteers, and our Mandarin Dual Immersion community."
	/>

	<section class="resources-content">
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-lg-8">
					{
						resourceCategories.map((category) => (
							<section class="resource-category">
								<h2>{category.title}</h2>

								<ul class="resource-list">
									{category.resources.map((resource) => (
										<li>
											<a
												href={resource.href}
												target="_blank"
												rel="noopener noreferrer"
											>
												{resource.title}
											</a>

											<p>{resource.description}</p>
										</li>
									))}
								</ul>
							</section>
						))
					}
				</div>
			</div>
		</div>
	</section>
</BaseLayout>


