---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import MeetingCard from "../components/MeetingCard.astro";

const upcomingMeetings = [
	{
		title: "BMDIB General Meeting",
		date: "Date TBD",
		location: "Location TBD",
		agenda: "#",
	},
	{
		title: "BMDIB General Meeting",
		date: "Date TBD",
		location: "Location TBD",
		agenda: "#",
	},
];

const pastMeetings = [
	{
		title: "BMDIB General Meeting",
		date: "Past Date",
		location: "Location TBD",
		agenda: "#",
		slides: "#",
		minutes: "#",
	},
	{
		title: "BMDIB General Meeting",
		date: "Past Date",
		location: "Location TBD",
		agenda: "#",
		slides: "#",
		minutes: "#",
	},
];
---

<BaseLayout
	title="General Meetings | Mandarin Boosters"
	description="Upcoming and past general meetings of Mandarin Boosters."
>
	<PageHeader
		eyebrow="General Meetings"
		title="General Meetings"
		description="Placeholder introduction to BMDIB general meetings. Final content will be provided by the organization."
	/>

	<section class="meetings-upcoming">
		<div class="container">
			<div class="row">
				<div class="col-12">
					<h2>Upcoming Meetings</h2>
				</div>
			</div>

			<div class="row g-4">
				{
					upcomingMeetings.map((meeting) => (
						<div class="col-md-6 col-lg-4">
							<MeetingCard {...meeting} />
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="meetings-past">
		<div class="container">
			<div class="row">
				<div class="col-12">
					<h2>Past Meetings</h2>
				</div>
			</div>

			<div class="row g-4">
				{
					pastMeetings.map((meeting) => (
						<div class="col-md-6 col-lg-4">
							<MeetingCard {...meeting} />
						</div>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>