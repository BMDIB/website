---
import { getCollection, render } from "astro:content";
import { getPacificToday } from "../utils/dateTime";

import BaseLayout from "../layouts/BaseLayout.astro";
import MeetingCard from "../components/MeetingCard.astro";
import PageHeader from "../components/PageHeader.astro";

const meetings = await getCollection("meetings");

const today = getPacificToday();

const upcomingMeetings = meetings
	.filter((meeting) => meeting.data.date >= today)
	.sort((a, b) => {
		const dateComparison = a.data.date.localeCompare(b.data.date);

		if (dateComparison !== 0) {
			return dateComparison;
		}

		return a.data.time.localeCompare(b.data.time);
	});

const pastMeetings = meetings
	.filter((meeting) => meeting.data.date < today)
	.sort((a, b) => {
		const dateComparison = b.data.date.localeCompare(a.data.date);

		if (dateComparison !== 0) {
			return dateComparison;
		}

		return b.data.time.localeCompare(a.data.time);
	});

const renderedUpcomingMeetings = await Promise.all(
	upcomingMeetings.map(async (meeting) => ({
		meeting,
		Content: (await render(meeting)).Content,
	}))
);

const renderedPastMeetings = await Promise.all(
	pastMeetings.map(async (meeting) => ({
		meeting,
		Content: (await render(meeting)).Content,
	}))
);
---

<BaseLayout
	title="General Meetings | Mandarin Boosters"
	description="Upcoming and past general meetings from Mandarin Boosters."
>
	<PageHeader
		eyebrow="General Meetings"
		title="General Meetings"
		description="Placeholder introduction to BMDIB general meetings. Final content will be provided by the organization."
	/>

	<section class="meetings-upcoming">
		<div class="container">
			<div class="row">
				<div class="col-12">
					<h2>Current &amp; Upcoming Meetings</h2>
				</div>
			</div>

			<div class="row g-4">
				{
					renderedUpcomingMeetings.map(({ meeting, Content }) => (
						<div class="col-md-6 col-lg-4">
							<MeetingCard
								title={meeting.data.title}
								date={meeting.data.date}
								time={meeting.data.time}
								location={meeting.data.location}
								agenda={meeting.data.agenda}
								slides={meeting.data.slides}
								minutes={meeting.data.minutes}
							>
								<Content />
							</MeetingCard>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="meetings-past">
		<div class="container">
			<div class="row">
				<div class="col-12">
					<h2>Past Meetings</h2>
				</div>
			</div>

			<div class="row g-4">
				{
					renderedPastMeetings.map(({ meeting, Content }) => (
						<div class="col-md-6 col-lg-4">
							<MeetingCard
								title={meeting.data.title}
								date={meeting.data.date}
								time={meeting.data.time}
								location={meeting.data.location}
								agenda={meeting.data.agenda}
								slides={meeting.data.slides}
								minutes={meeting.data.minutes}
							>
								<Content />
							</MeetingCard>
						</div>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>