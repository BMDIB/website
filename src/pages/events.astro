---
import { getCollection, render } from "astro:content";
import { getPacificToday } from "../utils/dateTime";

import BaseLayout from "../layouts/BaseLayout.astro";
import EventCard from "../components/EventCard.astro";
import PageHeader from "../components/PageHeader.astro";

// Loads all the Markdown event entries
const events = await getCollection("events");

// Determine today's calendar date in BMDIB's local Pacific timezone.
// Using YYYY-MM-DD allows reliable string comparison with event dates.
const today = getPacificToday();

// Current and upcoming events are sorted from earliest to latest.
// If multiple events occur on the same date, sort them by time.
const upcomingEvents = events
	.filter((event) => event.data.date >= today)
	.sort((a, b) => {
		const dateComparison = a.data.date.localeCompare(b.data.date);

		if (dateComparison !== 0) {
			return dateComparison;
		}

		return a.data.time.localeCompare(b.data.time);
	});

// Past events are sorted from most recent to oldest.
// If multiple events occurred on the same date, show the later one first.
const pastEvents = events
	.filter((event) => event.data.date < today)
	.sort((a, b) => {
		const dateComparison = b.data.date.localeCompare(a.data.date);

		if (dateComparison !== 0) {
			return dateComparison;
		}

		return b.data.time.localeCompare(a.data.time);
	});

// Render the Markdown body for each event before generating the page markup.
const renderedUpcomingEvents = await Promise.all(
	upcomingEvents.map(async (event) => ({
		event,
		Content: (await render(event)).Content,
	}))
);

const renderedPastEvents = await Promise.all(
	pastEvents.map(async (event) => ({
		event,
		Content: (await render(event)).Content,
	}))
);
---

<BaseLayout
	title="Events | Mandarin Boosters"
	description="Upcoming and past events from Mandarin Boosters."
>
	<PageHeader
		eyebrow="Events"
		title="Events"
		description="Placeholder introduction to BMDIB events. Final content will be provided by the organization."
	/>

	<section class="events-upcoming">
		<div class="container">
			<div class="row">
				<div class="col-12">
					<h2>Current &amp; Upcoming Events</h2>
				</div>
			</div>

			<div class="row g-4">
				{
					renderedUpcomingEvents.map(({ event, Content }) => (
						<div class="col-md-6 col-lg-4">
							<EventCard
								title={event.data.title}
								date={event.data.date}
								time={event.data.time}
								location={event.data.location}
							>
								<Content />
							</EventCard>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="events-past">
		<div class="container">
			<div class="row">
				<div class="col-12">
					<h2>Past Events</h2>
				</div>
			</div>

			<div class="row g-4">
				{
					renderedPastEvents.map(({ event, Content }) => (
						<div class="col-md-6">
							<EventCard
								title={event.data.title}
								date={event.data.date}
								time={event.data.time}
								location={event.data.location}
								images={event.data.images}
							>
								<Content />
							</EventCard>
						</div>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>