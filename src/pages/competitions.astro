---
import { getCollection, render } from "astro:content";
import { getPacificToday } from "../utils/dateTime";

import BaseLayout from "../layouts/BaseLayout.astro";
import CompetitionCard from "../components/CompetitionCard.astro";
import PageHeader from "../components/PageHeader.astro";

const competitions = await getCollection("competitions");

const today = getPacificToday();

const upcomingCompetitions = competitions
	.filter((competition) => competition.data.date >= today)
	.sort((a, b) => {
		const dateComparison = a.data.date.localeCompare(b.data.date);

		if (dateComparison !== 0) {
			return dateComparison;
		}

		return a.data.time.localeCompare(b.data.time);
	});

const pastCompetitions = competitions
	.filter((competition) => competition.data.date < today)
	.sort((a, b) => {
		const dateComparison = b.data.date.localeCompare(a.data.date);

		if (dateComparison !== 0) {
			return dateComparison;
		}

		return b.data.time.localeCompare(a.data.time);
	});

const renderedUpcomingCompetitions = await Promise.all(
	upcomingCompetitions.map(async (competition) => ({
		competition,
		Content: (await render(competition)).Content,
	}))
);

const renderedPastCompetitions = await Promise.all(
	pastCompetitions.map(async (competition) => ({
		competition,
		Content: (await render(competition)).Content,
	}))
);
---

<BaseLayout
	title="Competitions | Mandarin Boosters"
	description="Upcoming and past competitions supported by Mandarin Boosters."
>
	<PageHeader
		eyebrow="Competitions"
		title="Competitions"
		description="Placeholder introduction to BMDIB competitions. Final content will be provided by the organization."
	/>

	<section class="competitions-upcoming">
		<div class="container">
			<div class="row">
				<div class="col-12">
					<h2>Current &amp; Upcoming Competitions</h2>
				</div>
			</div>

			<div class="row g-4">
				{
					renderedUpcomingCompetitions.map(
						({ competition, Content }) => (
							<div class="col-md-6 col-lg-4">
								<CompetitionCard
									title={competition.data.title}
									date={competition.data.date}
									time={competition.data.time}
									location={competition.data.location}
								>
									<Content />
								</CompetitionCard>
							</div>
						)
					)
				}
			</div>
		</div>
	</section>

	<section class="competitions-past">
		<div class="container">
			<div class="row">
				<div class="col-12">
					<h2>Past Competitions</h2>
				</div>
			</div>

			<div class="row g-4">
				{
					renderedPastCompetitions.map(
						({ competition, Content }) => (
							<div class="col-md-6 col-lg-4">
								<CompetitionCard
									title={competition.data.title}
									date={competition.data.date}
									time={competition.data.time}
									location={competition.data.location}
								>
									<Content />
								</CompetitionCard>
							</div>
						)
					)
				}
			</div>
		</div>
	</section>
</BaseLayout>