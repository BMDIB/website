---
import { getCollection, render } from "astro:content";
import { getPacificToday } from "../utils/dateTime";

import BaseLayout from "../layouts/BaseLayout.astro";
import CompetitionCard from "../components/CompetitionCard.astro";
import PageHeader from "../components/PageHeader.astro";

const competitions = await getCollection("competitions");

const today = getPacificToday();

const upcomingCompetitions = competitions
	.filter((competition) => competition.data.date >= today)
	.sort((a, b) => {
		const dateComparison = a.data.date.localeCompare(b.data.date);

		if (dateComparison !== 0) {
			return dateComparison;
		}

		return a.data.time.localeCompare(b.data.time);
	});

const pastCompetitions = competitions
	.filter((competition) => competition.data.date < today)
	.sort((a, b) => {
		const dateComparison = b.data.date.localeCompare(a.data.date);

		if (dateComparison !== 0) {
			return dateComparison;
		}

		return b.data.time.localeCompare(a.data.time);
	});

const renderedUpcomingCompetitions = await Promise.all(
	upcomingCompetitions.map(async (competition) => ({
		competition,
		Content: (await render(competition)).Content,
	}))
);

const renderedPastCompetitions = await Promise.all(
	pastCompetitions.map(async (competition) => ({
		competition,
		Content: (await render(competition)).Content,
	}))
);
---

<BaseLayout
	title="Competitions | Mandarin Boosters"
	description="Upcoming and past competitions supported by Mandarin Boosters."
>
	<PageHeader
		eyebrow="Celebrating Student Achievement"
		title="Competitions"
		description="Learn how BMDIB supports students in developing their Mandarin language skills, building confidence, and celebrating their achievements through academic competitions."
	/>

	<section class="competition-section py-5">
		<div class="container">
			<article class="competition-article mx-auto">
				<h2 class="mb-4">BMDIB Competition Program</h2>

				<p>
					A message from our VP of Academic Programs:
				</p>

				<p>
					BMDIB works closely with the district to promote our dual
					language immersion programs by organizing and supporting key
					events throughout the school year. One of our proudest
					traditions is hosting the district-wide internal competition,
					which features Pinyin typing, speech, calligraphy, and writing
					for students from both Ruskin Elementary and Sierramont Middle
					School. Winners from our internal competition will go on to
					represent the Berryessa Union School District (BUSD) at the
					statewide competition hosted by the Association of Northern
					California Chinese Schools (ANCCS).
				</p>

				<div class="competition-gallery mt-5">
					{
						[
							{
								src: "/images/competitions/photo-1.jpg",
								alt: "Competition photo 1",
								caption: "",
							},
							{
								src: "/images/competitions/photo-2.jpg",
								alt: "Competition photo 2",
								caption: "",
							},
							{
								src: "/images/competitions/photo-3.jpg",
								alt: "Competition photo 3",
								caption: "",
							},
						].map((photo) => (
							<figure class="mb-5">
								<img
									src={photo.src}
									alt={photo.alt}
									class="img-fluid rounded competition-photo"
								/>
								<figcaption class="text-muted mt-2">
									{photo.caption}
								</figcaption>
							</figure>
						))
					}
				</div>
			</article>
		</div>
	</section>
</BaseLayout>