
---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Mandarin Boosters"
	description="Berryessa Mandarin Dual Immersion Boosters supports the K–8 Mandarin Dual Language Immersion Program through academic support, cultural enrichment, fundraising, and community engagement."
>
	<!-- Hero -->
	<section class="home-hero">
		<div class="container py-5">
			<div class="row align-items-center g-4">
				<div class="col-lg-8">
					<p class="home-hero-eyebrow">Mandarin Boosters</p>

					<h1 class="display-4 fw-bold">
						Supporting the Mandarin Immersion Program
					</h1>

					<p class="lead">
						Championing bilingual, bicultural, and biliterate
						excellence through academic support, cultural
						enrichment, and community involvement.
					</p>

					<div class="d-flex flex-wrap gap-2">
						<a class="btn btn-primary" href="/fundraising">
							Get Involved
						</a>

						<a class="btn btn-outline-secondary" href="/board">
							Meet the Board
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Mission -->
	<section class="home-section">
		<div class="container py-5">
			<div class="row justify-content-center">
				<div class="col-lg-8">
					<p class="section-eyebrow">Our Mission</p>

					<h2>Supporting our Mandarin immersion community</h2>

					<p class="lead">
						Our mission is to champion Berryessa Union School
						District's K–8 Mandarin Dual Language Immersion
						Program by partnering with district leaders to
						ensure long-term policy support, providing
						fundraising and classroom resources, and promoting
						strong parent engagement.
					</p>

					<p>
						We foster cultural exchange, connect elementary
						and middle school programs, and collaborate with
						other Mandarin immersion programs statewide and
						nationally.
					</p>

					<p>
						Through academic support, cultural enrichment,
						and community involvement, we strive to empower
						students to achieve bilingual, bicultural, and
						biliterate excellence, preparing them to thrive
						as global citizens.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- History -->
	<section class="home-section home-section-alt">
		<div class="container py-5">
			<div class="row align-items-center g-4">
				<div class="col-lg-5">
					<p class="section-eyebrow">Our History</p>

					<h2>Our story</h2>
				</div>

				<div class="col-lg-7">
					<p>
						Berryessa's Mandarin Dual Immersion Program
						started in 2018 with two kindergarten classes
						and one first-grade class. The program came
						together through the advocacy of a group of
						parents committed to creating a supportive
						Mandarin learning environment for their children.
						With the support of the school district, the
						program came to live at Cherrywood Elementary School
						in 2018 and has since expanded through 8th
						grade.
					</p>

					<p>
						Previously operating as Cherrywood Home &amp;
						School Club, Berryessa Mandarin Dual Immersion
						Boosters was formed following school
						consolidation, when the Mandarin Dual Immersion
						Program moved to Ruskin Elementary School.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Get Involved -->
	<section class="home-cta">
		<div class="container py-5">
			<div class="row justify-content-center text-center">
				<div class="col-lg-8">
					<p class="section-eyebrow">Get Involved</p>

					<h2>Be part of our community</h2>

					<p>
						Join us in supporting Mandarin immersion
						education through cultural activities,
						community events, and fundraising initiatives.
						Together, we can create meaningful learning
						experiences for our students.
					</p>

					<a class="btn btn-primary" href="/events">
						Explore Events
					</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
