---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Mandarin Boosters"
	description="Mandarin Boosters supports the Mandarin Immersion Program through community engagement and fundraising."
>
	<!-- Hero -->
	<section class="home-hero">
		<div class="container py-5">
			<div class="row align-items-center g-4">
				<div class="col-lg-8">
					<p class="home-hero-eyebrow">Mandarin Boosters</p>

					<h1 class="display-4 fw-bold">
						Supporting the Mandarin Immersion Program
					</h1>

					<p class="lead">
						Placeholder introduction for BMDIB. Final homepage messaging will
						be provided by the organization.
					</p>

					<div class="d-flex flex-wrap gap-2">
						<a class="btn btn-primary" href="/fundraising">
							Get Involved
						</a>

						<a class="btn btn-outline-secondary" href="/board">
							Meet the Board
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Mission -->
	<section class="home-section">
		<div class="container py-5">
			<div class="row justify-content-center">
				<div class="col-lg-8">
					<p class="section-eyebrow">Our Mission</p>

					<h2>Supporting our Mandarin immersion community</h2>

					<p class="lead">
						Placeholder mission content. The organization's official mission
						statement will be added when provided by the board.
					</p>

					<p>
						Additional placeholder content can be used here to establish the
						final layout and spacing.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- History -->
	<section class="home-section home-section-alt">
		<div class="container py-5">
			<div class="row align-items-center g-4">
				<div class="col-lg-5">
					<p class="section-eyebrow">Our History</p>

					<h2>Our story</h2>
				</div>

				<div class="col-lg-7">
					<p>
						Placeholder history content. This section will introduce the
						history of Mandarin Boosters and explain how the organization
						developed over time.
					</p>

					<p>
						The final history narrative will be provided by the organization.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Get Involved -->
	<section class="home-cta">
		<div class="container py-5">
			<div class="row justify-content-center text-center">
				<div class="col-lg-8">
					<p class="section-eyebrow">Get Involved</p>

					<h2>Be part of our community</h2>

					<p>
						Placeholder content for a short call to action. This section can
						guide visitors toward fundraising, events, resources, or other ways
						to participate.
					</p>

					<a class="btn btn-primary" href="/events">
						Explore Events
					</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>