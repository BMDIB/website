---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
---

<BaseLayout
	title="Fundraising | Mandarin Boosters"
	description="Learn why Mandarin Boosters fundraises and find the current fundraising campaign."
>
	<PageHeader
		eyebrow="Fundraising"
		title="Support Mandarin Boosters"
		description="Placeholder introduction to BMDIB fundraising. Final content will be provided by the organization."
	/>

	<section class="fundraising-why">
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-lg-8">
					<h2>Why We Fundraise</h2>

					<p>
						Placeholder content explaining why BMDIB fundraises and how
						fundraising supports the Mandarin immersion community.
					</p>

					<p>
						Final fundraising information and messaging will be provided by
						the organization.
					</p>
				</div>
			</div>
		</div>
	</section>

	<section class="fundraising-campaign">
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-lg-8 text-center">
					<h2>Current Campaign</h2>

					<p>
						Placeholder description for the current BMDIB fundraising
						campaign.
					</p>

					<a
						class="btn btn-primary"
						href="#"
						target="_blank"
						rel="noopener noreferrer"
					>
						View Current Campaign
					</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>