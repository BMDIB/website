---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
---

<BaseLayout
	title="Fundraising | Mandarin Boosters"
	description="Learn why Mandarin Boosters fundraises and find the current fundraising campaign."
>
	<PageHeader
		eyebrow="Supporting Our Students"
		title="Fundraising"
		description="Support BMDIB's annual giving campaign and help enrich the Mandarin Dual Immersion experience for our students."
	/>

	<section class="fundraising-section py-5">
		<div class="container">
			<div class="fundraising-content mx-auto">

				<!-- Why We Fundraise -->
				<section class="mb-5">
					<h2 class="mb-4">Why We Fundraise</h2>

					<p>
						Basic school funding only covers essential costs.
						To make our K–8 Mandarin Program truly top-tier,
						we rely on parent support to bridge the funding gap:
					</p>

					<ul class="fundraising-benefits">
						<li>
							<strong>Enhancing Classrooms:</strong>
							Funds Mandarin books, specialized teaching materials,
							and software subscriptions across K–8.
						</li>
						<li>
							<strong>Expanding Experiences:</strong>
							Brings cultural assemblies, educational field trips,
							and enrichment programs to our students.
						</li>
					</ul>

					<p class="mt-4 mb-1">
						We are a 501(c)(3) nonprofit organization
						(Tax ID: 77-0392868).
					</p>

					<p class="small text-muted">
						<em>
							Your donation may be tax deductible.
							Please consult with your tax advisor.
						</em>
					</p>
				</section>

				<!-- Current Campaign -->
				<section>
					
					<h2 class="mb-3">2026–27 Annual Giving Campaign</h2>

					<div class="text-center mt-4 mb-5">
						<a
							href="https://my.cheddarup.com/c/berryessa-mandarin-dual-immersion-boosters-invest-campaign-co/items"
							class="btn btn-primary"
							target="_blank"
							rel="noopener noreferrer"
						>
							Support Our Campaign
						</a>
					</div>
					<div class="fundraising-infographics">
						<figure class="mb-4">
							<img
								src="/images/fundraising/2026-27-annual-giving-1.png"
								alt="2026–27 annual giving campaign infographic explaining where the fund goes"
								class="img-fluid rounded"
								loading="lazy"
							/>
						</figure>

						<figure class="mb-4">
							<img
								src="/images/fundraising/2026-27-annual-giving-2.png"
								alt="2026–27 annual giving campaign infographic explaining the giving campaign"
								class="img-fluid rounded"
								loading="lazy"
							/>
						</figure>
					</div>

				</section>

			</div>
		</div>
	</section>
</BaseLayout>