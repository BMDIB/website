---
interface Props {
	title: string;
	date: string;
	time: string;
	location?: string;
	agenda?: string;
	slides?: string;
	minutes?: string;
}

const {
	title,
	date,
	time,
	location,
	agenda,
	slides,
	minutes,
} = Astro.props;

const [year, month, day] = date.split("-").map(Number);
const [hour, minute] = time.split(":").map(Number);

const formattedDate = new Intl.DateTimeFormat("en-US", {
	weekday: "short",
	year: "numeric",
	month: "long",
	day: "numeric",
	timeZone: "UTC",
}).format(new Date(Date.UTC(year, month - 1, day)));

const formattedTime = new Intl.DateTimeFormat("en-US", {
	hour: "numeric",
	minute: "2-digit",
	hour12: true,
	timeZone: "UTC",
}).format(new Date(Date.UTC(2000, 0, 1, hour, minute)));
---

<article class="meeting-card">
	<div class="meeting-card-content">
		<p class="meeting-card-date">
			<time datetime={`${date}T${time}`}>
				{formattedDate} · {formattedTime}
			</time>
		</p>

		<h2>{title}</h2>

		{location && <p class="meeting-card-location">{location}</p>}

		<div class="meeting-card-description">
			<slot />
		</div>

		{
			(agenda || slides || minutes) && (
				<div class="meeting-card-materials">
					{agenda && <a href={agenda}>Agenda</a>}
					{slides && <a href={slides}>Slides</a>}
					{minutes && <a href={minutes}>Minutes</a>}
				</div>
			)
		}
	</div>
</article>