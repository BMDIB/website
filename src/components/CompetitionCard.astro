---
interface Props {
	title: string;
	date: string;
	time: string;
	location?: string;
}

const { title, date, time, location } = Astro.props;

const [year, month, day] = date.split("-").map(Number);
const [hour, minute] = time.split(":").map(Number);

const formattedDate = new Intl.DateTimeFormat("en-US", {
	weekday: "short",
	year: "numeric",
	month: "long",
	day: "numeric",
	timeZone: "UTC",
}).format(new Date(Date.UTC(year, month - 1, day)));

const formattedTime = new Intl.DateTimeFormat("en-US", {
	hour: "numeric",
	minute: "2-digit",
	hour12: true,
	timeZone: "UTC",
}).format(new Date(Date.UTC(2000, 0, 1, hour, minute)));
---

<article class="competition-card">
	<div class="competition-card-content">
		<p class="competition-card-date">
			<time datetime={`${date}T${time}`}>
				{formattedDate} · {formattedTime}
			</time>
		</p>

		<h2>{title}</h2>

		{location && <p class="competition-card-location">{location}</p>}

		<div class="competition-card-description">
			<slot />
		</div>
	</div>
</article>