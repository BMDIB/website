---
interface Props {
	title: string;
	date: string;
	time: string;
	location?: string;
}

const { title, date, time, location } = Astro.props;

// The event date and time are stored as local Pacific calendar values.
// UTC is used here only as a neutral formatting mechanism so that the
// build machine's timezone does not change the displayed values.

const [year, month, day] = date.split("-").map(Number);
const [hour, minute] = time.split(":").map(Number);

// Example, if there are date: "2026-11-14" and time: "17:00"
// in Markdown
// This line s 2026/11/14 00:00 UTC time to this weekday, year, month, 
// day format:  

const formattedDate = new Intl.DateTimeFormat("en-US", {
	weekday: "short",
	year: "numeric",
	month: "long",
	day: "numeric",
	timeZone: "UTC",
}).format(new Date(Date.UTC(year, month - 1, day)));

const formattedTime = new Intl.DateTimeFormat("en-US", {
	hour: "numeric",
	minute: "2-digit",
	hour12: true,
	timeZone: "UTC",
}).format(new Date(Date.UTC(2000, 0, 1, hour, minute)));
---

<article class="event-card">
	<div class="event-card-content">
		<p class="event-card-date">
			<time datetime={`${date}T${time}`}>
				{formattedDate} · {formattedTime}
			</time>
		</p>

		<h2>{title}</h2>

		{location && <p class="event-card-location">{location}</p>}

		<div class="event-card-description">
			<slot />
		</div>
	</div>
</article>