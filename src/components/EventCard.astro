---
interface Props {
	title: string;
	date: string;
	description: string;
	location?: string;
}

const { title, date, description, location } = Astro.props;
---

<article class="event-card">
	<div class="event-card-content">
		<p class="event-card-date">{date}</p>

		<h2>{title}</h2>

		{location && <p class="event-card-location">{location}</p>}

		<p>{description}</p>
	</div>
</article>